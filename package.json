{
  "name": "capshield-smart-contracts",
  "version": "1.0.0",
  "description": "CAPX and ANGEL token contracts for CAPShield ecosystem",
  "main": "index.js",
  "scripts": {
    "compile": "npx hardhat compile",
    "clean": "npx hardhat clean",
    "test": "npx hardhat test",
    "test:angel": "npx hardhat test test/ANGEL.test.js",
    "test:capx": "npx hardhat test test/CAPX.test.js",
    "test:vesting": "npx hardhat test test/TokenVesting.test.js",
    "test:gas": "REPORT_GAS=true npx hardhat test",
    "coverage": "npx hardhat coverage",
    "gas:report": "REPORT_GAS=true npx hardhat test",
    "node:local": "npx hardhat node",
    "check:balance": "node scripts/check-balance.js",
    "generate:wallet": "node scripts/generate-wallet.js",
    "deploy:tokens:local": "npx hardhat run scripts/deploy.js --network localhost",
    "deploy:tokens:polygon:testnet": "npx hardhat run scripts/deploy.js --network polygonAmoy",
    "deploy:tokens:polygon": "npx hardhat run scripts/deploy.js --network polygon",
    "deploy:tokens:bsc:testnet": "npx hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:tokens:bsc": "npx hardhat run scripts/deploy.js --network bsc",
    "deploy:mockadmin:local": "npx hardhat run scripts/deploy-mockadmin.js --network localhost",
    "deploy:mockadmin:polygon:testnet": "npx hardhat run scripts/deploy-mockadmin.js --network polygonAmoy",
    "deploy:mockadmin:polygon": "npx hardhat run scripts/deploy-mockadmin.js --network polygon",
    "deploy:mockadmin:bsc:testnet": "npx hardhat run scripts/deploy-mockadmin.js --network bscTestnet",
    "deploy:mockadmin:bsc": "npx hardhat run scripts/deploy-mockadmin.js --network bsc",
    "deploy:vesting:local": "npx hardhat run scripts/deploy-vesting.js --network localhost",
    "deploy:vesting:polygon:testnet": "npx hardhat run scripts/deploy-vesting.js --network polygonAmoy",
    "deploy:vesting:polygon": "npx hardhat run scripts/deploy-vesting.js --network polygon",
    "deploy:vesting:bsc:testnet": "npx hardhat run scripts/deploy-vesting.js --network bscTestnet",
    "deploy:vesting:bsc": "npx hardhat run scripts/deploy-vesting.js --network bsc",
    "configure:exemption:local": "npx hardhat run scripts/configure-exemption.js --network localhost",
    "configure:exemption:polygon:testnet": "npx hardhat run scripts/configure-exemption.js --network polygonAmoy",
    "configure:exemption:polygon": "npx hardhat run scripts/configure-exemption.js --network polygon",
    "configure:exemption:bsc:testnet": "npx hardhat run scripts/configure-exemption.js --network bscTestnet",
    "configure:exemption:bsc": "npx hardhat run scripts/configure-exemption.js --network bsc",
    "verify:polygon:testnet": "npx hardhat run scripts/verify.js --network polygonAmoy",
    "verify:polygon": "npx hardhat run scripts/verify.js --network polygon",
    "verify:bsc:testnet": "npx hardhat run scripts/verify.js --network bscTestnet",
    "verify:bsc": "npx hardhat run scripts/verify.js --network bsc"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.15",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.16",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.14",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^9.1.1",
    "@types/node": "^20.19.24",
    "chai": "^4.3.10",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6"
  }
}