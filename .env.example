# Deployment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit your actual .env file with real keys!

# Deployer private key (the account that will deploy the contracts)
PRIVATE_KEY=your_deployer_private_key_here

# Multisig contract address (MUST be a contract, not an EOA)
# This will be the admin/owner of both CAPY and SEED tokens
# Example: Gnosis Safe on BSC
MULTISIG_ADDRESS=0x...

# Treasury address (receives 1% transfer fees from CAPY)
TREASURY_ADDRESS=0x...

# DAO address (used for DAO minting in CAPY)
DAO_ADDRESS=0x...

# BscScan API Key (for contract verification)
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Optional: RPC URLs (if not using default)
# BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
# BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
